# ============================================================
#  Cadenas de conexión para los servidores MCP de SQL Server
# ------------------------------------------------------------
#  Copia este archivo a  db/.env  y rellena tus valores.
#  db/.env está en .gitignore: NO se sube al repo.
#
#  Una variable por base, con el patrón  MSSQL_CONNSTR_<ALIAS>.
#  Ese mismo <ALIAS> debe coincidir con el bloque de .mcp.json
#  (servidor "mssql-<alias>").
#
#  Formato de cadena:
#    Server=<host>[\instancia][,puerto];Database=<bd>;
#    User Id=<usuario>;Password=<pass>;TrustServerCertificate=True;Encrypt=True;
# ============================================================

# --- Base 1: AdventureWorks (demo, solo lectura) ---
MSSQL_CONNSTR_ADVENTUREWORKS=Server=localhost;Database=AdventureWorks2025;User Id=demo_readonly;Password=CAMBIA_ESTA_CONTRASENA;TrustServerCertificate=True;Encrypt=True;

# --- Base 2: (renombra el alias y completa) ---
MSSQL_CONNSTR_BD2=Server=localhost;Database=NombreBD2;User Id=usuario;Password=***;TrustServerCertificate=True;Encrypt=True;

# --- Base 3: (opcional) ---
MSSQL_CONNSTR_BD3=Server=OTRO-SERVIDOR\SQLEXPRESS;Database=NombreBD3;User Id=usuario;Password=***;TrustServerCertificate=True;Encrypt=True;
