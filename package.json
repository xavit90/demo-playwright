{
  "name": "demo-playwright",
  "version": "1.0.0",
  "description": "App de demostración front-end como campo de práctica para Playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "browser:open": "node scripts/app/browser-server.js",
    "serve": "npx serve -l 5511"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
